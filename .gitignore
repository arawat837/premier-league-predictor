# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Environment and secrets
.env
.env.*
!.env.example

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp

# Data files (raw downloaded seasons are excluded to keep repo lightweight)
data/raw/*.csv
!data/raw/upcoming_fixtures.csv
!data/raw/.gitkeep
data/processed/*.parquet
!data/processed/.gitkeep
!data/processed/features.parquet
!data/processed/oof_predictions.parquet

# Pre-trained model weights (calibrated XGBoost pipeline tracked for cloud deployment)
models/*.joblib
!models/calibrated_xgb.joblib
models/*.pkl
!models/.gitkeep

# Streamlit runtime state
.streamlit/secrets.toml
